# Binaries
/bin/
*.exe
*.dll
*.so
*.dylib

# Test artifacts
*.out
coverage.html
*.test

# Env
.env
.env.local
.env.openai

# Local bearer-token store
/auth.json
/auth.json.lock

# Generated knowledge-base index (rebuilt by POST /index; holds a full copy of docs/)
.kb/
log/
docs/.kbimport-*/
eval/.kbimport-*/
*.bak/

# IDE
.idea/
.vscode/
*.swp
*.swo
.codex
.agents

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Vendor
/vendor/

docs/
eval/

# 公司語料衍生的測試資料 —— 題目與預期答案直接引用 POS 業務規則,
# 與 docs/ 同樣不進版控。本機保留,由 bundle 重建。
/testdata/
/internal/kb/testdata/

# eval 執行結果 —— 連模型答案與引用的 corpus 片段都存了,比題庫更敏感
/metrics/

# 來源清單含內部絕對路徑;範本見 kb_sources.json.example
/kb_sources.json

# 驗收查詢語句
/postman/
# 錨在根目錄:不加斜線會連 .claude/skills/*/templates/run_eval.py 一起擋掉
/run_eval.py
/eval_out.json
.agents/

# .claude/ 本身要進版控(skills 是驗收流程的一部分),但這兩樣不進:
# local 是每台機器自己的許可清單,pycache 是編譯產物。
.claude/settings.local.json
.claude/**/__pycache__/

# 驗收原始輸出。要保留的那一輪在 metrics/(理由見 metrics/README.md);
# 根目錄這些是跑到一半的中間產物,語料一改就沒有比較基準。
/eng_eval*.json
/eval_out*.json
/kb-validation-*.json