[Unit]
Description=llm-platform inference gateway
Documentation=https://github.com/linkc0829/llm-platform/blob/main/deploy/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=llm-platform
Group=llm-platform
# Config comes from .env in this directory (viper reads it from the working
# directory), the same layout the service uses today.
WorkingDirectory=/opt/llm-platform
ExecStart=/opt/llm-platform/bin/gateway
# Restart after a crash or a non-zero exit, not after `systemctl stop`.
Restart=on-failure
RestartSec=2s
# The binary drains in-flight requests on SIGTERM within APP_SHUTDOWN_TIMEOUT;
# give it that long plus margin before SIGKILL.
TimeoutStopSec=30s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/llm-platform

[Install]
WantedBy=multi-user.target
