# ============================================================================
# Application
# ============================================================================
APP_ENV=development
APP_NAME=knowledge-base-qa-bot
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
LOG_ENCODING=json

# ============================================================================
# OpenAI / LLM
# ============================================================================
OPENAI_API_KEY=
KB_LLM_MODE=openai
# Ollama uses its OpenAI-compatible endpoint; no API key is needed when this is set.
OPENAI_BASE_URL=http://localhost:11434/v1
# Optional: use a different OpenAI-compatible endpoint for embeddings.
KB_EMBED_BASE_URL=
KB_CHAT_MODEL=llama3.1:8b
KB_EMBED_MODEL=snowflake-arctic-embed2
KB_DOCS_DIR=docs
KB_INDEX_DIR=.kb
