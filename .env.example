# ============================================================================
# Application
# ============================================================================
APP_ENV=development
APP_NAME=knowledge-base-qa-bot
APP_PORT=12598
APP_SHUTDOWN_TIMEOUT=10s

# ============================================================================
# Authentication
# ============================================================================
# Required by cmd/kb unless KB_AUTH_DISABLED is explicitly true.
KB_AUTH_FILE=
# Local-only escape hatch; cmd/kb forces 127.0.0.1 when true.
KB_AUTH_DISABLED=false

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
LOG_ENCODING=json
# Comma-separated sinks: stdout, stderr, or a file path. Keep the file sink —
# the kb_query / llm_usage lines are the only record of what the KB was asked.
LOG_OUTPUT=stdout,log/kb.log

# ============================================================================
# OpenAI-compatible LLM
# ============================================================================
OPENAI_API_KEY=
KB_LLM_MODE=openai
# Ollama uses its OpenAI-compatible endpoint; no API key is needed when this is set.
OPENAI_BASE_URL=http://localhost:11434/v1
# Optional: use a different OpenAI-compatible endpoint for embeddings.
KB_EMBED_BASE_URL=
# Optional: overrides OPENAI_API_KEY for embedding requests only.
KB_EMBED_API_KEY=
# Optional Gemini OpenAI-compatible setting. minimal disables Gemma 4 thinking.
KB_GEMINI_THINKING_LEVEL=
KB_CHAT_MODEL=llama3.1:8b
# Decoding parameters. Unset, the upstream falls back to the served model's own
# generation_config (Gemma defaults to temperature 1.0), which makes repeated
# eval rounds disagree with each other. Grounded QA wants greedy decoding.
KB_CHAT_TEMPERATURE=0
# 0 omits max_tokens. Answers cite their sources in the closing lines, so a
# limit that truncates costs the citation, not just prose.
KB_CHAT_MAX_TOKENS=1024
KB_EMBED_MODEL=snowflake-arctic-embed2
KB_DOCS_DIR=docs
KB_INDEX_DIR=.kb
# Forward caller principal ID to internal gateway via X-On-Behalf-Of header.
# Only enable when OPENAI_BASE_URL targets the internal Gateway, never public cloud.
KB_LLM_FORWARD_USER=false
# Optional timeout for POST /index operations. Server WriteTimeout scales with this value (defaults to 60s).
# Set to 10m when rebuilding index during embedding model migration.
KB_INDEX_TIMEOUT=

# ============================================================================
# API Gateway (cmd/gateway)
# ============================================================================
# Required upstream base URL (without trailing /v1)
GATEWAY_UPSTREAM_BASE_URL=
GATEWAY_UPSTREAM_API_KEY=
GATEWAY_UPSTREAM_HEADER_TIMEOUT=300s
GATEWAY_MAX_INFLIGHT=64
GATEWAY_MAX_INFLIGHT_PER_USER=4
GATEWAY_PORT=12599
GATEWAY_LOG_OUTPUT=stdout,log/gateway.log
# Optional dedicated embedding upstream base URL and API key.
# When omitted, embeddings forward to GATEWAY_UPSTREAM_BASE_URL.
GATEWAY_EMBED_UPSTREAM_BASE_URL=
GATEWAY_EMBED_UPSTREAM_API_KEY=
# Embedding model name bound to /v1/embeddings. When set, Gateway enforces strict model name matching (400 if mismatched).
# Usage is always tracked for /v1/embeddings in gateway_usage regardless of this setting.
# Rule: When changing models, always change the model name; reusing aliases across different models is forbidden.
GATEWAY_EMBED_MODEL=
